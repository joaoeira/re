{
  "name": "@simbyotic/re-core",
  "version": "0.1.0",
  "bugs": {
    "url": "https://github.com/joaoeira/re/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoeira/re.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build",
    "pretest": "bun run build",
    "pretest:watch": "bun run build",
    "pretypecheck": "bun run build"
  },
  "dependencies": {
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@types/bun": "latest",
    "effect": "3.19.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "effect": "^3.19.18"
  }
}

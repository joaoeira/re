{
  "name": "@re/workspace",
  "version": "0.0.1",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench:snapshot": "bun scripts/bench-snapshot.ts",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build",
    "pretest": "bun run build",
    "pretest:watch": "bun run build",
    "pretypecheck": "bun run build"
  },
  "dependencies": {
    "@re/core": "workspace:*",
    "ignore": "^5.3.2",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-node-shared": "^0.57.0",
    "@effect/vitest": "^0.27.0",
    "@types/bun": "latest",
    "effect": "3.19.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@effect/platform": "^0.94.5",
    "effect": "^3.19.18"
  }
}

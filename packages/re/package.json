{
  "name": "@simbyotic/re",
  "version": "0.2.0",
  "description": "Markdown flashcards, built-in item types, FSRS scheduling, and Effect workspace services",
  "bugs": {
    "url": "https://github.com/joaoeira/re/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoeira/re.git",
    "directory": "packages/re"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./item-types": {
      "types": "./dist/item-types/index.d.ts",
      "import": "./dist/item-types/index.js",
      "default": "./dist/item-types/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js",
      "default": "./dist/scheduler/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js",
      "default": "./dist/workspace/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build",
    "pretest": "bun run build",
    "pretest:watch": "bun run build",
    "pretypecheck": "bun run build",
    "bench": "vitest bench",
    "bench:snapshot": "bun scripts/workspace/bench-snapshot.ts"
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "nanoid": "^5.1.6",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-node-shared": "^0.57.0",
    "@effect/vitest": "^0.27.0",
    "@types/bun": "latest",
    "effect": "3.19.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@effect/platform": "^0.94.5",
    "effect": "^3.19.18"
  },
  "peerDependenciesMeta": {
    "@effect/platform": {
      "optional": true
    }
  }
}

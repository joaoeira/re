{
  "name": "re",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch && bun run build:libraries",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "typecheck": "bun run --filter '*' typecheck",
    "desktop:dev": "bun run --filter @re/desktop dev",
    "desktop:typecheck": "bun run --filter @re/desktop typecheck",
    "desktop:test": "bun run --filter @re/desktop test",
    "desktop:build": "bun run --filter @re/desktop build",
    "desktop:package": "bun run --filter @re/desktop package",
    "desktop:install": "bun run --filter @re/desktop install:local",
    "raycast:dev": "bun --cwd=apps/raycast run dev",
    "raycast:test": "bun --cwd=apps/raycast run test",
    "raycast:typecheck": "bun --cwd=apps/raycast run typecheck",
    "raycast:build": "bun --cwd=apps/raycast run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "build:libraries": "tsc -b tsconfig.build.json",
    "watch:libraries": "tsc -b tsconfig.build.json --watch",
    "pack:libraries": "node scripts/pack-libraries.mjs",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "^0.64.1",
    "@oxlint/plugins": "^1.55.0",
    "@types/bun": "latest",
    "add": "^2.0.6",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.55.0",
    "typescript": "^5.9.3"
  }
}
